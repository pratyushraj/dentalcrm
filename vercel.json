{
  "framework": "vite",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(llms\\.txt|llms-full\\.txt)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/\\.well-known/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/webhook/:provider",
      "destination": "/api/webhook?provider=:provider"
    },
    {
      "source": "/api/push/:path*",
      "destination": "https://creatorarmour-api-k86q.onrender.com/api/push/:path*"
    },
    {
      "source": "/blog/:slug*",
      "destination": "/api/meta"
    },
    {
      "source": "/cities/:city*",
      "destination": "/api/meta"
    },
    {
      "source": "/tools",
      "destination": "/api/meta"
    },
    {
      "source": "/rx",
      "destination": "/api/meta"
    },
    {
      "source": "/calculator",
      "destination": "/api/meta"
    },
    {
      "source": "/dental-implant-loan",
      "destination": "/api/meta"
    },
    {
      "source": "/clear-aligners-on-emi",
      "destination": "/api/meta"
    },
    {
      "source": "/deck",
      "destination": "/api/meta"
    },
    {
      "source": "/demo/loan",
      "destination": "/api/meta"
    },
    {
      "source": "/review/assist",
      "destination": "/api/meta"
    },
    {
      "source": "/clinic-onboarding",
      "destination": "/api/meta"
    },
    {
      "source": "/pilot-onboarding",
      "destination": "/api/meta"
    },
    {
      "source": "/clinic-pilot",
      "destination": "/api/meta"
    },
    {
      "source": "/partner-pipeline",
      "destination": "/api/meta"
    },
    {
      "source": "/clinic-agreement",
      "destination": "/api/meta"
    },
    {
      "source": "/sub-merchant-terms",
      "destination": "/api/meta"
    },
    {
      "source": "/sub-merchant-agreement",
      "destination": "/api/meta"
    },
    {
      "source": "/terms",
      "destination": "/api/meta"
    },
    {
      "source": "/terms-and-conditions",
      "destination": "/api/meta"
    },
    {
      "source": "/privacy",
      "destination": "/api/meta"
    },
    {
      "source": "/privacy-policy",
      "destination": "/api/meta"
    },
    {
      "source": "/refund-policy",
      "destination": "/api/meta"
    },
    {
      "source": "/cancellation-policy",
      "destination": "/api/meta"
    },
    {
      "source": "/shipping-policy",
      "destination": "/api/meta"
    },
    {
      "source": "/delivery-policy",
      "destination": "/api/meta"
    },
    {
      "source": "/contact",
      "destination": "/api/meta"
    },
    {
      "source": "/contact-us",
      "destination": "/api/meta"
    },
    {
      "source": "/",
      "destination": "/api/meta"
    },
    {
      "source": "/((?!api/|assets/|docs/|favicon|.*\\.(?:jpg|jpeg|png|webp|svg|ico|json|txt|xml|pdf|docx|xlsx)|sw\\.js|site\\.webmanifest|manifest\\.json).*)",
      "destination": "/index.html"
    }
  ]
}
